# Les variables ${NC_DOMAIN}, ${SITE_ORIGIN} et ${SITE_URL} sont remplacées au démarrage du conteneur nginx.

# Origines autorisées à appeler WebDAV/OCS depuis le navigateur (site vitrine + développement local)
map $http_origin $cors_origin {
    default "";
    "${SITE_ORIGIN}" $http_origin;
    "~^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$" $http_origin;
}

# Pour les appels CORS, on retire le défi "WWW-Authenticate" (évite la pop-up de connexion du navigateur).
# Les clients classiques (synchro, explorateur WebDAV) le reçoivent normalement.
map $cors_origin $nc_www_authenticate {
    ""      $upstream_http_www_authenticate;
    default "";
}

upstream nextcloud_backend {
    server nextcloud:80;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NC_DOMAIN} localhost;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/cloud.crt;
    ssl_certificate_key /etc/nginx/certs/cloud.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Aucune limite de taille d'envoi, transferts longs en streaming
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host;

    # API utilisée par la page "Mes fichiers" du site vitrine
    location ~ ^/(remote\.php/dav|ocs)/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $cors_origin always;
            add_header Access-Control-Allow-Methods "GET, PUT, DELETE, PROPFIND, MKCOL, MOVE, COPY, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Depth, Destination, Overwrite, OCS-APIRequest" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Vary Origin always;
            return 204;
        }

        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header WWW-Authenticate;
        add_header WWW-Authenticate $nc_www_authenticate always;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Expose-Headers "ETag, Content-Length, Content-Type, Content-Disposition, OC-FileId" always;
        add_header Vary Origin always;
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

        proxy_pass http://nextcloud_backend;
    }

    # Page de connexion Nextcloud : ajout d'un bouton « Retour au site » (aussi affiché après déconnexion)
    location = /login {
        # sub_filter ne peut modifier qu'une réponse non compressée.
        # Redéclarer un proxy_set_header annule l'héritage : on remet donc tous ceux du bloc server.
        proxy_set_header Accept-Encoding "";
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;

        sub_filter_once on;
        sub_filter '</body>' '<a href="${SITE_URL}" style="position:fixed;top:16px;left:16px;z-index:10000;display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:999px;background:rgba(255,255,255,.94);color:#0b1220;font:600 14px/1.2 system-ui,-apple-system,Segoe UI,sans-serif;text-decoration:none;box-shadow:0 4px 14px rgba(11,18,32,.18)">&larr; Retour au site</a></body>';

        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        proxy_pass http://nextcloud_backend;
    }

    location / {
        add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
        proxy_pass http://nextcloud_backend;
    }
}

# Copier ce fichier en .env puis remplacer TOUTES les valeurs "change-me".
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Nom de domaine ou IP du serveur cloud (ex. cloud.mondomaine.fr ou 192.168.1.50)
NC_DOMAIN=localhost
# Port HTTPS exposé sur la machine hôte
HTTPS_PORT=443

# Origine du site vitrine autorisée à appeler l'API WebDAV (CORS), sans slash final
# ex. https://mon-compte.github.io
SITE_ORIGIN=https://mon-compte.github.io

# Compte administrateur Nextcloud créé au premier démarrage
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me

# Base de données / cache
MARIADB_ROOT_PASSWORD=change-me
MARIADB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Production uniquement (docker-compose.nas.yml)
NAS_IP=192.168.1.20
NAS_EXPORT=/volume1/nextcloud-data

# Sauvegardes (scripts/backup.sh) — idéalement un montage du NAS
BACKUP_DIR=./backups
